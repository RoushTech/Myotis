{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Default": "Data Source=#{myotis.database.path}"
    },
    "Myotis": {
        "Smtp": {
            "PublicHost": "#{myotis.smtp.public.host}",
            "Certificate": {
                "CertificatePath": "#{myotis.smtp.certificate.path}",
                "KeyPath": "#{myotis.smtp.certificate.key.path}"
            },
            "Listeners": [
                {
                    "Port": "#{myotis.smtp.port}",
                    "Tls": "#{myotis.smtp.tls}",
                    "PublicPort": "#{myotis.smtp.public.port}"
                }
            ],
            "TrustedProxies": "#{myotis.smtp.trusted.proxies}"
        },
        "Web": {
            "TrustedProxies": "#{myotis.web.trusted.proxies}"
        }
    }
}
